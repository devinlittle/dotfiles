Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host mac-mini
    HostName mac-mini.internal
    User devin
    StreamLocalBindUnlink yes         # Wipes stale socket files on dropped connections
    #               REMOTE LOCATION TO COPY TO          LOCAL LOCATION COPYING FROM
    RemoteForward /Users/devin/.gnupg/S.gpg-agent /run/user/1000/gnupg/S.gpg-agent.extra
    RemoteForward /Users/devin/.ssh/S.gpg-agent.ssh /run/user/1000/gnupg/S.gpg-agent.ssh
