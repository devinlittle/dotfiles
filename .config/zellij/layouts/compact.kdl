layout {

	swap_floating_layout name="staggered" {
	    floating_panes
	}

	swap_floating_layout name="enlarged" {
	    floating_panes max_panes=10 {
		pane { x "5%"; y 1; width "90%"; height "90%"; }
		pane { x "5%"; y 2; width "90%"; height "90%"; }
		pane { x "5%"; y 3; width "90%"; height "90%"; }
		pane { x "5%"; y 4; width "90%"; height "90%"; }
		pane { x "5%"; y 5; width "90%"; height "90%"; }
		pane { x "5%"; y 6; width "90%"; height "90%"; }
		pane { x "5%"; y 7; width "90%"; height "90%"; }
		pane { x "5%"; y 8; width "90%"; height "90%"; }
		pane { x "5%"; y 9; width "90%"; height "90%"; }
		pane { x 10; y 10; width "90%"; height "90%"; }
	    }
	}

	swap_floating_layout name="spread" {
	    floating_panes max_panes=1 {
		pane {y "50%"; x "50%"; }
	    }
	    floating_panes max_panes=2 {
		pane { x "1%"; y "25%"; width "45%"; }
		pane { x "50%"; y "25%"; width "45%"; }
	    }
	    floating_panes max_panes=3 {
		pane { y "55%"; width "45%"; height "45%"; }
		pane { x "1%"; y "1%"; width "45%"; }
		pane { x "50%"; y "1%"; width "45%"; }
	    }
	    floating_panes max_panes=4 {
		pane { x "1%"; y "55%"; width "45%"; height "45%"; }
		pane { x "50%"; y "55%"; width "45%"; height "45%"; }
		pane { x "1%"; y "1%"; width "45%"; height "45%"; }
		pane { x "50%"; y "1%"; width "45%"; height "45%"; }
	    }
	}

    default_tab_template {
	children

        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "{mode}#[fg=#181825,bg=#89B4FA,bold] {session} #[fg=#89B4FA,bg=#181825] {tabs}"
                format_right "#[fg=#313244,bg=#181825]#[fg=#cdd6f4,bg=#313244] {datetime} "
                format_space "#[bg=#181825]"

                mode_normal        "#[bg=#89B4FA,fg=#181825,bold] "
                mode_locked        "#[bg=#f38ba8,fg=#181825,bold] LOCKED "
                mode_tmux          "#[bg=#fab387,fg=#181825,bold] TMUX "
                mode_pane          "#[bg=#a6e3a1,fg=#181825,bold] PANE "
                mode_tab           "#[bg=#cba6f7,fg=#181825,bold] TAB "
                mode_resize        "#[bg=#f9e2af,fg=#181825,bold] RESIZE "
                mode_move          "#[bg=#94e2d5,fg=#181825,bold] MOVE "
                mode_scroll        "#[bg=#89dceb,fg=#181825,bold] SCROLL "
                mode_search        "#[bg=#f5c2e7,fg=#181825,bold] SEARCH "
                mode_session       "#[bg=#f2cdcd,fg=#181825,bold] SESSION "
                mode_prompt        "#[bg=#bac2de,fg=#181825,bold] PROMPT "
                mode_rename_tab    "#[bg=#cba6f7,fg=#181825,bold] RENAME "
                mode_rename_pane   "#[bg=#a6e3a1,fg=#181825,bold] RENAME "

                tab_normal              "#[fg=#181825,bg=#45475a] #[fg=#cdd6f4,bg=#45475a]{index}  {name} #[fg=#45475a,bg=#181825]"
                tab_normal_fullscreen   "#[fg=#181825,bg=#45475a] #[fg=#cdd6f4,bg=#45475a]{index}  {name} [] #[fg=#45475a,bg=#181825]"
                tab_normal_sync         "#[fg=#181825,bg=#45475a] #[fg=#cdd6f4,bg=#45475a]{index}  {name} <> #[fg=#45475a,bg=#181825]"

                tab_active              "#[fg=#181825,bg=#cdd6f4,bold] #[fg=#181825,bg=#cdd6f4,bold]{index}  {name} #[fg=#cdd6f4,bg=#181825]"
                tab_active_fullscreen   "#[fg=#181825,bg=#cdd6f4,bold] #[fg=#181825,bg=#cdd6f4,bold]{index}  {name} [] #[fg=#cdd6f4,bg=#181825]"
                tab_active_sync         "#[fg=#181825,bg=#cdd6f4,bold] #[fg=#181825,bg=#cdd6f4,bold]{index}  {name} <> #[fg=#cdd6f4,bg=#181825]"

                hide_frame_for_single_pane "false"
                border_enabled  "false"

                datetime        "#[fg=#cdd6f4]{format}"
                datetime_format "%a %d %b  %H:%M"
                datetime_timezone "America/New_York"

                // command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                // command_git_branch_format      "#[fg=#89B4FA] {stdout} "
                // command_git_branch_interval    "10"
                // command_git_branch_rendermode  "static"
                // command_git_branch_cwd         "{focused_pane_cwd}"
            }
        }
    }
}


